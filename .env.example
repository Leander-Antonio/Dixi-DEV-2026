# Copie este arquivo para ".env" (na raiz do projeto) e ajuste os valores
# conforme necessário. O ".env" é lido automaticamente pelo docker-compose.yml.
#
#   cp .env.example .env

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=dixi_backend
MYSQL_PORT=3306

# ---- Backend (Spring Boot) ----
# DB_USER e DB_PASSWORD devem corresponder às credenciais do MySQL acima
DB_USER=root
DB_PASSWORD=root
BACKEND_PORT=8080

# ---- Frontend ----
FRONTEND_PORT=5173
